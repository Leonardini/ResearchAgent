# Copy alongside the delivered scripts; load relative to __file__.
figure.figsize: 6.4, 3.8
figure.dpi: 120
figure.facecolor: white
savefig.dpi: 300
savefig.facecolor: white
savefig.bbox: tight
font.family: sans-serif
font.size: 10
axes.labelsize: 10
axes.titlesize: 11
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: 222222
axes.labelcolor: 222222
axes.prop_cycle: cycler('color', ['2166AC', 'C62828', '2E7D32'])
axes.axisbelow: True
axes.grid: False
text.color: 222222
xtick.color: 222222
ytick.color: 222222
xtick.labelsize: 9
ytick.labelsize: 9
lines.linewidth: 1.8
lines.markersize: 5
legend.fontsize: 9
legend.frameon: False
svg.fonttype: none
pdf.fonttype: 42
